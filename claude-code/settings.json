{
  "env": {
    "ANTHROPIC_AUTH_TOKEN": "YOUR_ANTHROPIC_AUTH_TOKEN_HERE",
    "ANTHROPIC_BASE_URL": "https://api.kimi.com/coding",
    "ANTHROPIC_DEFAULT_HAIKU_MODEL": "kimi-k2.7-coding",
    "ANTHROPIC_DEFAULT_HAIKU_MODEL_NAME": "kimi-k2.7-coding",
    "ANTHROPIC_DEFAULT_OPUS_MODEL": "kimi-k2.7-coding",
    "ANTHROPIC_DEFAULT_OPUS_MODEL_NAME": "kimi-k2.7-coding",
    "ANTHROPIC_DEFAULT_SONNET_MODEL": "kimi-k2.7-coding",
    "ANTHROPIC_DEFAULT_SONNET_MODEL_NAME": "kimi-k2.7-coding",
    "ANTHROPIC_MODEL": "kimi-k2.7-coding",
    "CLAUDE_CODE_DISABLE_TERMINAL_TITLE": "1",
    "CLAUDE_CODE_EFFORT_LEVEL": "max"
  },
  "hooks": {
    "Notification": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/usr/local/bin/node /Users/zhaoziqi/.claude/statusbar/update.js notify"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "/usr/local/bin/node /Users/zhaoziqi/.claude/statusbar/update.js post"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "/usr/local/bin/node /Users/zhaoziqi/.claude/statusbar/update.js pre"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/usr/local/bin/node /Users/zhaoziqi/.claude/statusbar/lifecycle.js end"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/usr/local/bin/node /Users/zhaoziqi/.claude/statusbar/lifecycle.js start"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/usr/local/bin/node /Users/zhaoziqi/.claude/statusbar/update.js stop"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/usr/local/bin/node /Users/zhaoziqi/.claude/statusbar/update.js prompt"
          }
        ]
      }
    ],
    "StopFailure": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh -c 'afplay \"$HOME/Library/Sounds/surprise-mother-fer.aiff\"'"
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "bash /Users/zhaoziqi/.claude/plugins/claude-statusline-hud/scripts/statusline.sh"
  },
  "enabledPlugins": {
    "swift-lsp@claude-plugins-official": true
  }
}
