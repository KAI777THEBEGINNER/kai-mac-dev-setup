# Build artifacts
*.o
*.a
*.dylib

# Secrets (should already be placeholders, but guard against accidental commits)
*.key
*.pem
*.env
.env.local

# OS files
.DS_Store
.AppleDouble
.LSOverride

# User-specific runtime data
*.log
*.db
*.sqlite
*.sqlite3

# Python
__pycache__/
*.pyc

# Nested repos vendored as skills
pi/skills/*/.git/

# Local sync artifacts
*.sync-tmp
