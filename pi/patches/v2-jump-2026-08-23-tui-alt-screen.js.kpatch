+    // KAI-PATCH: 直接跳到「最新一条」用户输入（shift+up 用），
+    // 从渲染内容末尾往前找第一条用户消息标记，找不到则回到底部。
+    scrollToLatestInput() {
+        if (!this.currentLayout)
+            return;
+        const scrollView = this.getPrimaryScrollView();
+        const lines = getScrollViewBox(this.currentLayout, scrollView)?.scrollContentLines;
+        if (!lines) {
+            scrollView.scrollToEnd();
+            this.requestRender();
+            return;
+        }
+        for (let row = lines.length - 1; row >= 0; row--) {
+            if (!KAI_USER_MARKER.test(lines[row] ?? ""))
+                continue;
+            // KAI-PATCH: 落点补偿 -2 行（视口与内容行有 2 行偏移），保证消息文本可见。
+            scrollView.scrollTo(Math.max(0, row - 2));
+            this.requestRender();
+            return;
+        }
+        scrollView.scrollToEnd();
+        this.requestRender();
