+// KAI-PATCH: Claude Code 式「上一条 prompt」提示栏。
+// 当用户向上滚动离开底部时，在 transcript 与编辑器之间显示一行：
+// ▲ <最后一条用户消息（可点击跳回）>   shift+up 跳回 · end 回底部
+// 点击消息文本（OSC 8 链接）或按 shift+up 立即跳回上一条 prompt。
+class PreviousPromptBar {
+    constructor(getState) {
+        this.getState = getState;
+    }
+    render(width) {
+        const state = this.getState();
+        if (!state || !state.visible || width < 24)
+            return [];
+        const label = theme.fg("accent", "▲");
+        const hint = theme.fg("dim", "点击跳回");
+        const maxText = Math.max(6, width - visibleWidth(label) - 1 - visibleWidth(hint) - 3);
+        // 整条都是 OSC 8 点击热区，点任意位置跳到上一条用户消息
+        const promptText = theme.underline(truncateToWidth(state.promptText ?? "", maxText));
+        const line = hyperlink(`${label} ${promptText} · ${hint}`, "pi-jump://prev-prompt");
+        return [truncateToWidth(line, width)];
+    }
+    invalidate() { }
 }
+
 export class InteractiveMode {
     runtimeHost;
     renderer;
