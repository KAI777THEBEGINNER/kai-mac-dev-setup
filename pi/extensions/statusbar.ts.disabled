// Pi → ClaudeStatusBar 菜单栏 HUD 桥接扩展
// 把 pi 的事件映射成 ~/.claude/statusbar/ 现有脚本的输入（update.js / lifecycle.js），
// 完全复用 Claude 时代搭好的 SwiftBar 应用与状态机，两个 harness 共用一个菜单栏。
// update.js 读 stdin JSON（session_id / tool_name / cwd / transcript_path）后原子写
// state.d/<session_id>.json；lifecycle.js 负责 app 启停与 state 清理。
import type { ExtensionAPI } from "@earendil-works/pi-coding-agent";
import { spawn } from "node:child_process";
import os from "node:os";
import path from "node:path";

const SB_DIR = path.join(os.homedir(), ".claude", "statusbar");
const NODE = "/usr/local/bin/node";

// pi 工具名（小写）→ update.js 的 TOOL_LABELS key（Claude 风格大写）
const TOOL_MAP: Record<string, string> = {
  bash: "Bash",
  read: "Read",
  write: "Write",
  edit: "Edit",
  grep: "Grep",
  find: "Glob",
  ls: "Glob",
};

// 即发即忘调用 statusbar 脚本：spawn 后立即 unref，不阻塞 pi 主流程
function runScript(script: string, event: string, payload: Record<string, unknown>) {
  try {
    const p = spawn(NODE, [path.join(SB_DIR, script), event], {
      stdio: ["pipe", "ignore", "ignore"],
      detached: true,
    });
    p.stdin?.write(JSON.stringify(payload));
    p.stdin?.end();
    p.unref();
  } catch {
    /* 菜单栏不可用时静默降级 */
  }
}

export default function (pi: ExtensionAPI) {
  // session 文件路径（如 ~/.pi/agent/sessions/<cwd>/<uuid>.jsonl）→ uuid
  const sid = (ctx: { sessionManager?: { getSessionFile?: () => string | null } }) => {
    const f = ctx?.sessionManager?.getSessionFile?.() ?? "";
    return path.basename(f).replace(/\.jsonl?$/, "") || "unknown";
  };

  pi.on("session_start", async (_event, ctx) => {
    runScript("lifecycle.js", "start", { session_id: sid(ctx), cwd: ctx.cwd });
  });

  pi.on("session_shutdown", async (_event, ctx) => {
    runScript("lifecycle.js", "end", { session_id: sid(ctx) });
  });

  // 用户提交输入 → thinking
  pi.on("before_agent_start", async (_event, ctx) => {
    runScript("update.js", "prompt", {
      session_id: sid(ctx),
      cwd: ctx.cwd,
      transcript_path: ctx.sessionManager?.getSessionFile?.() ?? "",
    });
  });

  // 工具开始执行 → Running <tool>
  pi.on("tool_execution_start", async (event, ctx) => {
    runScript("update.js", "pre", {
      session_id: sid(ctx),
      tool_name: TOOL_MAP[event.toolName] ?? event.toolName,
    });
  });

  // 工具结束 → 回到 thinking
  pi.on("tool_execution_end", async (_event, ctx) => {
    runScript("update.js", "post", { session_id: sid(ctx) });
  });

  // agent 整体完成（含重试/compaction 后的最终落定）→ Done
  pi.on("agent_settled", async (_event, ctx) => {
    runScript("update.js", "stop", { session_id: sid(ctx) });
  });
}
