# Ghostty 自定义 Shader 配置
# 中英文都用更纱黑体 Sarasa Term SC：
#   拉丁 = Iosevka（0.5em），中文 = 思源黑体（1em），两个英文严格等于一个汉字
#   0 是斜杠，斜体是真斜体（转折圆润）
# 只留这一个字体族 + 系统中文兜底：多挂一个西文字体会在缺字时造成混排。
# 没装字体时 Ghostty 回退到自带 JetBrains Mono + PingFang SC。
font-family = Sarasa Term SC
font-family = PingFang SC

# 默认字号：系统默认 13 + 3（等价于每次启动自动按三次 Cmd+=）
# 只设启动初始值，不锁死，Cmd+= / Cmd+- / Cmd+0 仍可随时调整
font-size = 16

# 禁用窗口状态恢复，防止 macOS 自动回到之前的 Claude Code session
window-save-state = never

# 视口高度通常不是行高的整数倍，余数默认全堆在底部/右侧，看起来像多了一行空白。
# step-resize：手动拖窗口时按整格吸附，从根上消掉余数。
# 不要加 window-padding-balance：它把余数分到四边，网格起点落到半像素上，
# 中文句号「。」的环形会被拉成正圆（2026-10-24 实测），失去原有的竖椭圆观感。
window-step-resize = true

# 启动 zsh，由 .zshrc 自动拉起 zellij
command = zsh -il
background = #000000

# ---- 定制化背景（透明度 / 毛玻璃 / 三个自定义 shader）----
# 已抽到下面这个文件，用 `ghostty-bg` 一键开关：
#   ghostty-bg          切换
#   ghostty-bg off      纯黑不透明、无毛玻璃、无 shader（截图/录屏/省电）
#   ghostty-bg on       恢复定制背景
#   ghostty-bg status   看当前状态
# 脚本：~/.local/bin/ghostty-bg   自动热重载，不会重启 Ghostty
config-file = ?background.conf

# 按序链式生效: cursor_blaze -> bettercrt -> starfield_downloaded

# 只在终端内容变化时渲染，不在后台空转 60fps
custom-shader-animation = true
